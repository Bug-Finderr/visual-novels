# Frontend build-time config (Vite reads VITE_* at build).
#
# Local dev: leave these unset — the app defaults to '/api/v1' and
# '/game-assets', which Vite proxies to the local backend (see vite.config.js).
#
# Production (Netlify): set these in the Netlify UI, not here.
#   VITE_API_BASE   — Cloud Run origin + version, e.g.
#                     https://storyplex-api-abc123-uc.a.run.app/api/v1
#   VITE_ASSET_BASE — public GCS/CDN base for generated assets, e.g.
#                     https://storage.googleapis.com/storyplex-assets

# VITE_API_BASE=
# VITE_ASSET_BASE=
