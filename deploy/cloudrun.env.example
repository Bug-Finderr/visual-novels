# Backend environment for Cloud Run (StoryPlex API).
# Non-secret values can go in --set-env-vars; secrets should come from Secret
# Manager via --set-secrets (see DEPLOY.md). This file documents every var.

# --- Persistence (Cloud SQL for Postgres, via the unix socket Cloud Run mounts) ---
# The @/ + host=/cloudsql/... form connects through the mounted socket; pass the
# instance to Cloud Run with --add-cloudsql-instances=PROJECT:REGION:INSTANCE.
DATABASE_URL=postgresql+psycopg://storyplex:PASSWORD@/storyplex?host=/cloudsql/PROJECT:REGION:INSTANCE

# --- Generated assets → public GCS bucket ---
ASSET_BACKEND=gcs
GCS_BUCKET=storyplex-assets
# Optional: a Cloud CDN / custom domain in front of the bucket. Defaults to
# https://storage.googleapis.com/<GCS_BUCKET> when unset.
# GCS_PUBLIC_BASE=https://cdn.example.com

# --- AI / TTS providers (put the actual keys in Secret Manager) ---
GEMINI_API_KEY=secret:gemini-api-key
SILK_API_KEY=secret:silk-api-key
STORYGEN_ENGINE=graph

# --- Auth (Google OAuth) ---
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=secret:google-client-secret
# The backend handles the callback; must be an Authorized redirect URI on the
# OAuth client.
GOOGLE_REDIRECT_URI=https://storyplex-api-xxxx.run.app/api/v1/auth/google/callback

# --- Session cookie + CORS ---
SESSION_SECRET=secret:session-secret
# HTTPS in prod → always Secure.
SESSION_COOKIE_SECURE=1
# 'lax' if the SPA + API share a registrable domain (custom-domain subdomains —
# recommended). 'none' if you use the raw *.netlify.app + *.run.app hosts
# (cross-site; relies on third-party cookies, which some browsers block).
SESSION_COOKIE_SAMESITE=lax
# First entry is also the post-login redirect target (the SPA origin).
ALLOWED_ORIGINS=https://app.example.com
