# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Core AI ---
GEMINI_API_KEY=your-gemini-key

# Model ids. Optional — these override the defaults in app/config.py without a
# code change, which matters because Google retires models on their own
# schedule (the 2.5 line started 404ing while it was still the default).
# Run `./.venv/bin/python scripts/verify_models.py` after changing them.
#   story    gemini-3-flash-preview       $0.50/M in,  $3.00/M out
#   dialogue gemini-3.1-flash-lite        $0.25/M in,  $1.50/M out
#   image    gemini-3.1-flash-lite-image  $0.0336/image  (cheapest that works)
MODEL_STORY=
MODEL_DIALOGUE=
MODEL_IMAGE=

# --- TTS (Silk / Mulberry) ---
SILK_API_KEY=your-silk-key

# --- Story engine ---
STORYGEN_ENGINE=monolith          # or "graph" for the LangGraph multi-agent engine

# How many stories may generate at once; the rest queue and are shown their
# place in line. A pipeline peaks near 500MB, so 3 fits a 2GB box with room to
# spare. Raising this without the RAM to back it risks an OOM, which kills
# every in-flight generation and the web service with it.
MAX_CONCURRENT_GENERATIONS=3

# --- Database (Phase 1) ---
# Matches the local docker-compose Postgres. Swap host/creds for a managed DB.
DATABASE_URL=postgresql+psycopg://storyplex:storyplex@localhost:5432/storyplex

# --- Accounts / Google OAuth (Phase 1) ---
# Create an "OAuth 2.0 Client ID" of type "Web application" in Google Cloud
# Console → APIs & Services → Credentials. Add the redirect URI below as an
# "Authorized redirect URI", and http://localhost:3000 as an "Authorized
# JavaScript origin". Login stays disabled until CLIENT_ID + SECRET are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# Random 32+ char secret for signing session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SPA runs — credentialed-CORS allowlist (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000

# --- Billing: prepaid credits + Cashfree (India, INR) ---
# Master switch. Off = story generation is free and nothing is debited, so
# local dev and the live demo work untouched until you're ready to charge.
BILLING_ENABLED=0
# Credits granted once, on first touch of a user's account. Raising this later
# never re-grants to users who already have an account.
FREE_STORY_CREDITS=2
CREDITS_PER_GENERATION=1
# Each attempt is charged, retries included. Flip to 1 during an upstream
# outage so failed generations hand the credit back.
REFUND_ON_GENERATION_FAILURE=0

# Sandbox credentials are issued on signup at merchant.cashfree.com with no
# KYC — enough to test the whole flow. Production keys need PAN + bank proof.
CASHFREE_ENV=sandbox              # or "production"
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Only set if Cashfree ever issues a webhook secret distinct from the secret
# key; otherwise the secret key is used to verify signatures.
CASHFREE_WEBHOOK_SECRET=

# Origin of the SPA (post-checkout return URL) and of this API (the webhook
# notify_url handed to Cashfree). Locally the defaults are fine; Cashfree
# can't reach localhost, so webhooks need a tunnel — see DEPLOY-RENDER.md.
PUBLIC_WEB_BASE=http://localhost:3000
PUBLIC_API_BASE=
